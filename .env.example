# ChipPilot configuration
# Required: Anthropic API key (or a compatible provider's key with ANTHROPIC_BASE_URL)
ANTHROPIC_API_KEY=replace-me-with-your-key

# Optional: third-party / proxy endpoint (leave unset for api.anthropic.com)
# ANTHROPIC_BASE_URL=

# Optional overrides
# MODEL_ID=claude-sonnet-4-6
# CHIPPILOT_PROJECT=default
